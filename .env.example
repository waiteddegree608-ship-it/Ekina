# Local configuration. No real credentials in this file.
# These OPENCODE_* names are retained by the backend for its compatible gateway.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_CHAT_MODEL=
EKINA_RESEARCH_MODEL=
EKINA_CHIEF_PROVIDER=opencode
EKINA_RESEARCH_PROVIDER=opencode
EKINA_SKIP_DEEPSEEK_PEAK=false

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:15432/ekina
SPRING_DATASOURCE_USERNAME=ekina
SPRING_DATASOURCE_PASSWORD=change-me-local-only

# Optional worker: install its CLI separately, then set an executable path and model.
EKINA_OPENCODE_CMD=opencode
EKINA_OPENCODE_MODEL=
EKINA_OPENCLAW_ENABLED=false
EKINA_LIFE_ENABLED=false
EKINA_PAPER_SCOUT_ENABLED=false
EKINA_NOTIFY_PERMISSION_DIALOG=false

# Optional full-text/document tools and external integrations.
S2_API_KEY=
EKINA_COMPUTE_SSH_HOST=
EKINA_COMPUTE_SSH_PORT=22
EKINA_COMPUTE_SSH_USER=
EKINA_SSH_PASSWORD=
EKINA_GITHUB_TOKEN=
EKINA_OVERLEAF_GIT_URL=
EKINA_OVERLEAF_TOKEN=
EKINA_EMBEDDING_PROVIDER=local
